# Copia este archivo como .env y rellena los valores.
# El .env NUNCA se sube a GitHub.

# Cadena de conexion de Supabase (Session pooler)
DATABASE_URL=

# Clave secreta para firmar los tokens JWT. Invéntala, larga y aleatoria.
JWT_SECRET=

# URL del frontend que tiene permiso para llamar a esta API.
# En local: http://127.0.0.1:5500
FRONTEND_URL=
